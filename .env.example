# ============================================================================
# House Research — пример .env
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# ============================================================================

# --- Telegram --------------------------------------------------------------
# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere

# ID чата/канала, куда бот будет публиковать объявления.
# Для супергрупп/каналов обычно отрицательное число.
TELEGRAM_CHAT_ID=-1001234567890

# --- Циан --------------------------------------------------------------
# Cookie авторизованного профиля агента Циан.
# Как получить: залогиньтесь на cian.ru под агентским профилем, откройте
# поиск объявлений, скопируйте значение заголовка Cookie из запроса к API
# и вставьте его целиком (в одинарных кавычках, т.к. внутри есть спецсимволы).
CIAN_SEARCH_COOKIE='cookie_name1=value1; cookie_name2=value2'

# --- Основной AI-провайдер (текстовый чат) ----------------------------------
# Любой OpenAI-совместимый endpoint: OpenRouter, Together, Groq, DeepInfra,
# свой vLLM/Ollama и т.д. — не важно, главное чтобы был путь /chat/completions.
# AI_API_KEY и AI_MODELS можно перечислить через запятую: при ошибке/лимите
# перебираются все комбинации модель×ключ по очереди.
#
# Пример на OpenRouter (там есть бесплатные модели, https://openrouter.ai/keys):
AI_ENDPOINT=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-example1,sk-or-v1-example2
AI_MODELS=deepseek/deepseek-r1:free,deepseek/deepseek-r1-0528:free

# --- Gemini (используется отдельно для мультимодалки: PDF/фото объявлений,
# поиск через Google Search grounding) ---------------------------------------
# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyExampleKey1,AIzaSyExampleKey2
# Базовый хост API Google, БЕЗ пути метода (путь достраивает сам SDK).
# Менять не нужно, если только не гоняете запросы через свой прокси/релей.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com
# GEMINI_CHAT_ENDPOINT нужен, только если для OpenAI-совместимого чата
# (в отличие от нативного Google SDK) требуется ДРУГОЙ хост, например свой
# прокси зеркалит один путь, а другой — нет. По умолчанию не задавайте её
# вообще: код сам возьмёт значение GEMINI_ENDPOINT.
# GEMINI_CHAT_ENDPOINT=https://generativelanguage.googleapis.com

# Модели тоже необязательны — по умолчанию используется "-latest" алиас
# (Google сам подставляет актуальную модель нужного уровня, никогда не
# протухнет). Задавайте вручную, только если хотите другую модель или у вас
# оплаченный тариф с доступом к Pro. Бесплатная квота "Pro"-моделей на
# большинстве аккаунтов равна нулю — не ставьте их сюда на free tier.
# Свои реальные RPM/RPD смотрите в Google AI Studio → Rate Limits.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_MODEL_LITE=gemini-flash-lite-latest

# Сколько запросов к Gemini на один ключ разрешено делать в минуту.
# Бесплатные лимиты обычно 5–16 RPM — не задирайте выше того, что видите
# в своём Rate Limits дэшборде, иначе будете ловить 429 с первых секунд.
# GEMINI_RPM=8

# --- RapidAPI (используется для поиска маршрутов/остановок) ----------------
# Ключ WikiRoutes: https://wikiroutes.info/en/developers
RAPID_API_KEY=example_rapidapi_key1,example_rapidapi_key2
