# ============================================================================
# House Research — пример .env
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# ============================================================================

# --- Telegram --------------------------------------------------------------
# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere

# ID чата/канала, куда бот будет публиковать объявления.
# Для супергрупп/каналов обычно отрицательное число.
TELEGRAM_CHAT_ID=-1001234567890

# --- Циан --------------------------------------------------------------
# Cookie авторизованного профиля агента Циан.
# Как получить: залогиньтесь на cian.ru под агентским профилем, откройте
# поиск объявлений, скопируйте значение заголовка Cookie из запроса к API
# и вставьте его целиком (в одинарных кавычках, т.к. внутри есть спецсимволы).
CIAN_SEARCH_COOKIE='cookie_name1=value1; cookie_name2=value2'

# --- AI провайдеры ----------------------------------------------------------
# Можно указать несколько ключей через запятую — при исчерпании дневного
# лимита библиотека автоматически переключится на следующий ключ.
# Если провайдер не используется — оставьте пустым, но переменная должна
# существовать (даже пустой строкой).

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-example1,sk-or-v1-example2

# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyExampleKey1,AIzaSyExampleKey2
# Эндпоинты Gemini обычно менять не нужно — используются значения по
# умолчанию из документации Google. Переопределяйте только если нужен
# кастомный прокси/ретранслятор.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
GEMINI_CHAT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# Nvidia NIM: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-example1,nvapi-example2

# Chutes AI: https://chutes.ai/
CHUTES_API_KEY=cpk_example_token

# --- RapidAPI (используется для поиска маршрутов/остановок) ----------------
# Ключ WikiRoutes: https://wikiroutes.info/en/developers
RAPID_API_KEY=example_rapidapi_key1,example_rapidapi_key2
